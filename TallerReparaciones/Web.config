<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="conexion" connectionString="Data Source=.\SQLEXPRESS01;Initial Catalog=TallerReparaciones;Integrated Security=True"
      providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
  </system.web>
  <system.webServer>
    <defaultDocument>
      <files>
        <add value="Presentacion/Menu.aspx" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
